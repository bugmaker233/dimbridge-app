[Unit]
Description=DimBridge FastAPI Backend
After=network.target

[Service]
Type=simple
User=dimbridge
Group=dimbridge
WorkingDirectory=/opt/dimbridge-app/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/dimbridge-app/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
